# =============================================================================
# Copy to `.env` (gitignored) or load via 1Password Environment + `op run`.
# =============================================================================

# Application
APP_ENV=development
# Long random string for JWT/signing; generate locally for dev.
APP_SECRET_KEY=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# DATABASE_URL — async SQLAlchemy + asyncpg
#
#   postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
# Default Compose Postgres (see docker-compose.yml):
#   USER=tether  PASSWORD=tether  DATABASE_NAME=tether
#
# From your Mac (Alembic, pytest, scripts on host): Postgres is mapped to host
# port 5455, so use localhost:5455
#
# From inside the backend container, Compose sets DATABASE_URL to the internal
# service (postgres:5432); you rarely override that for `docker compose up`.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://tether:tether@localhost:5455/tether

# -----------------------------------------------------------------------------
# Local LLM (LM Studio) — Anthropic-compatible API (testing)
#
# Load a model in LM Studio, enable Local Server, and enable the Anthropic API
# if offered. Copy the base URL from LM Studio (port/path vary).
#
# - On your Mac:  http://127.0.0.1:<port>  (often 1234)
# - Backend in Docker needs the host:  http://host.docker.internal:<port>
#
# API key: LM Studio usually accepts any non-empty placeholder.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=lm-studio
ANTHROPIC_BASE_URL=http://127.0.0.1:1234

# Auth (JWT defaults)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# 1Password: store real values in a 1Password Environment (Developer → View Environments),
# then run: op run --environment YOUR_ENVIRONMENT_ID -- docker compose up --build
# CI uses GitHub Actions secrets only — see .github/workflows/ci.yml
